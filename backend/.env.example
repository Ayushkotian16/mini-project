PORT=5000
MONGODB_URI=mongodb://localhost:27017/nandini_chende
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=qwerty11
ADMIN_PASSWORD=qwerty11
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 2Factor SMS OTP setting (keep the real value only in the root .env; never upload it)
TWO_FACTOR_API_KEY=your_2factor_api_key

# Email notifications — free via Gmail App Password
# 1. Enable 2FA on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate a 16-char app password for "Mail"
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ADMIN_NOTIFY_EMAIL=your_notify_email@gmail.com
